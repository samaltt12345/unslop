{
  "name": "geomaster",
  "installCommand": "npm install --include=dev",
  "buildCommand": "GEOMASTER_STATIC=1 npm run build",
  "outputDirectory": "out",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/_next/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
